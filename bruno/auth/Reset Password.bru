meta {
  name: Reset Password
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/users/reset-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "username": "admin",
    "newPassword": "secret123"
  }
}

docs {
  # Reset Password (Local / Dev Only)

  Resets the password for any user by username.

  ⚠️  This endpoint is **blocked in production** — it returns 403 Forbidden
  if `NODE_ENV=production` is set on the server.

  - Requires a valid Bearer token (login first).
  - `username` — the account to reset (e.g. `admin`).
  - `newPassword` — must be at least 6 characters.

  ## Default local admin credentials (Login.bru)
  username: admin
  password: secret123
}


